    const history = [...row.history, { at: new Date().toISOString(), event: `Proposition s├â┬⌐par├â┬⌐e en ${row.sources.length} propositions`, actor: admin.email, status: "├âΓé¼ s├â┬⌐parer" }];
    await client.query(`UPDATE "AiPrProposal" SET status='├âΓé¼ s├â┬⌐parer',history=$2,"updatedAt"=NOW() WHERE id=$1`, [parsed.data, JSON.stringify(history)]);
  });
  revalidatePath(path);
}

