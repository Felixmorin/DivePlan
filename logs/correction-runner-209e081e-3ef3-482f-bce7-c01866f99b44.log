      const status = source.finding.evidence && source.finding.recommendation ? "En attente d├óΓé¼Γäóapprobation" : "├âΓé¼ clarifier";
      await client.query(`INSERT INTO "AiPrProposal" (id,title,summary,sources,details,status,history) VALUES ($1,$2,$3,$4,$5,$6,$7)`, [
        nextId, title, source.finding.evidence ?? row.summary, JSON.stringify([source]), JSON.stringify(row.details), status,
        JSON.stringify([{ at: new Date().toISOString(), event: `Proposition s├â┬⌐par├â┬⌐e depuis ${row.title}`, actor: admin.email, status }])
      ]);
