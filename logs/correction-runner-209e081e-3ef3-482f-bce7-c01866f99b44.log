  const proposal = await withTransaction(async (client) => {
    const { rows } = await client.query<{
      id: string; title: string; summary: string; sources: ProposalSource[]; details: ProposalDetails; status: string;
      correctionStatus: string; correctionExecutionId: string | null; history: Array<Record<string, unknown>>;
    }>(`SELECT id,title,summary,sources,details,status,"correctionStatus",history FROM "AiPrProposal" WHERE id=$1 FOR UPDATE`, [parsed.data.id]);
    const row = rows[0];
    if (!row) throw new Error("Proposition introuvable.");
    validateApprovedProposal(row);
    if ((row.correctionStatus === "En attente d├óΓé¼Γäóex├â┬⌐cution" && row.correctionExecutionId) || ["Modifications effectu├â┬⌐es", "PR en brouillon pr├â┬¬te ├â┬á r├â┬⌐viser", "Termin├â┬⌐ apr├â┬¿s r├â┬⌐vision humaine"].includes(row.correctionStatus)) {
      throw new Error(`Une correction ne peut pas ├â┬¬tre lanc├â┬⌐e avec le statut ├é┬½ ${row.correctionStatus} ├é┬╗.`);
    }
    const restarting = row.correctionStatus === "En cours";
    const history = [...row.history, { at: new Date().toISOString(), event: restarting ? "Correction red├â┬⌐marr├â┬⌐e manuellement; l├óΓé¼Γäóex├â┬⌐cution pr├â┬⌐c├â┬⌐dente est invalid├â┬⌐e.": "Correction mise en file; le runner local lancera Codex avec la session ChatGPT configur├â┬⌐e sur ce d├â┬⌐p├â┬┤t.", actor: admin.email, status: "En attente d├óΓé¼Γäóex├â┬⌐cution" }];
    const proposalHash = hashCorrectionProposal(row);
    await client.query(`UPDATE "AiPrProposal" SET "correctionStatus"='En attente d├óΓé¼Γäóex├â┬⌐cution',"correctionExecutionId"=$2,"correctionProposalHash"=$3,"correctionRunUrl"=NULL,"correctionPullRequestUrl"=NULL,history=$4,"updatedAt"=NOW() WHERE id=$1`, [row.id, executionId, proposalHash, JSON.stringify(history)]);
    return row;
  });

  await trackEvent({ type: "admin.agent.correction.prepared", message: "Proposition approuv├â┬⌐e pr├â┬⌐par├â┬⌐e pour le Codex local", userId: admin.id, metadata: { proposalId: proposal.id, executionId } });
  revalidatePath(path);
