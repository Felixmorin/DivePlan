    limits: "Cumul des statistiques depuis leur r├â┬⌐initialisation, sans historique par jour; le texte SQL est volontairement exclu du rapport.",
    recommendation: "Examiner la requ├â┬¬te identifi├â┬⌐e par queryid dans un outil s├â┬⌐curis├â┬⌐, puis mesurer une optimisation avec un plan d├óΓé¼Γäóex├â┬⌐cution contr├â┬┤l├â┬⌐."
  })) ?? [];
  const codeFindings = code.findings.map((finding) => ({ ...finding, priority: finding.priority, impact: finding.impact, effort: finding.effort }));
  return {
    title: "Analyse SQL & Supabase DivePlan",
    period: { from: new Date(Date.now() - periodHours * 3600000).toISOString(), to: new Date().toISOString(), label: periodLabel },
    sources: [
      { name: "Code SQL, sch├â┬⌐ma Prisma et migrations", period: "├âΓÇ░tat d├â┬⌐ploy├â┬⌐ du d├â┬⌐p├â┬┤t", samples: code.fileCount },
      { name: "DatabaseEgressTelemetryHour", period: periodLabel, samples: egress.length },
