import "server-only";
import { query, withReadOnlyDatabaseUrl, withReadOnlyTransaction } from "@/lib/db";
import { analyzeDivePlanSqlCode } from "@/lib/sql-agent-analysis";
import { runArchitectureCartography, summarizePreviousCartography } from "@/lib/architecture-agent";
import { consolidateAgentFindings } from "@/lib/pr-agent-consolidation";

type RouteVolume = { route: string; requests: string; bytes: string };
type Vital = { route: string; metric: string; average: string; samples: string };
type EventCount = { type: string; count: string };
type AgentJob = { id: string; agentId: string; analysisPeriod: "24h" | "7d"; enabled: boolean; triggers: Record<string, { enabled?: boolean }> };
type SupabaseQueryStat = { queryId: string; calls: string; rows: string; totalMs: string; meanMs: string; sharedReadBlocks: string; sharedHitBlocks: string };

export async function runNextAgentJobs(targetRunId?: string) {
  let processed = 0;
  for (let index = 0; index < (targetRunId ? 1 : 5); index += 1) {
    const claimed = await query<AgentJob>(
      `WITH candidate AS (
         SELECT r.id FROM "AiAgentRun" r
         WHERE r.status = 'pending' AND ($1::text IS NULL OR r.id = $1)
           AND (r."workflowId" IS NULL OR NOT EXISTS (
             SELECT 1 FROM "AiAgentRun" previous
             WHERE previous."workflowId"=r."workflowId" AND previous.sequence<r.sequence
               AND previous.status NOT IN ('completed','failed','cancelled')
           ))
         ORDER BY r."createdAt",r."workflowId",r.sequence FOR UPDATE SKIP LOCKED LIMIT 1
       )
       UPDATE "AiAgentRun" r SET status = 'running', "startedAt" = NOW()
       FROM candidate, "AiAgent" a
       WHERE r.id = candidate.id AND a.id = r."agentId"
      RETURNING r.id, r."agentId", r."analysisPeriod", a.enabled, a.triggers`,
      [targetRunId ?? null]
    );
    const run = claimed.rows[0];
    if (!run) break;
    processed += 1;
    try {
      if (!run.enabled || run.triggers?.onDemand?.enabled !== true) {
        await query(`UPDATE "AiAgentRun" SET status='failed', error=$2, "finishedAt"=NOW() WHERE id=$1`, [run.id, "L├óΓé¼Γäóagent ou son d├â┬⌐clenchement ├â┬á la demande a ├â┬⌐t├â┬⌐ d├â┬⌐sactiv├â┬⌐ avant le traitement."]);
        continue;
      }
      if (run.agentId === "sql-supabase-analyst") {
        const result = await runSqlSupabaseAnalysis(run.analysisPeriod);
        await query(`UPDATE "AiAgentRun" SET status='completed', result=$2, "finishedAt"=NOW() WHERE id=$1`, [run.id, result]);
        continue;
      }
      if (run.agentId === "architecture-cartographer") {
        const previousResult = await query<{ result: unknown }>(
          `SELECT result FROM "AiAgentRun" WHERE "agentId"=$1 AND status='completed' AND id<>$2 ORDER BY "createdAt" DESC LIMIT 1`, [run.agentId, run.id]
        );
        const result = await runArchitectureCartography(summarizePreviousCartography(previousResult.rows[0]?.result));
        await query(`UPDATE "AiAgentRun" SET status='completed', result=$2, "finishedAt"=NOW() WHERE id=$1`, [run.id, result]);
        continue;
      }
      if (run.agentId === "pr-consolidation") {
        const consolidation = await consolidateAgentFindings();
        const result = {
          title: "Consolidation des propositions de PR",
          period: { from: new Date().toISOString(), to: new Date().toISOString(), label: "Rapports termin├â┬⌐s disponibles" },
          sources: [{ name: "AiAgentRun", period: "Rapports termin├â┬⌐s disponibles", samples: consolidation.examined }],
          facts: [{ category: "Rapports examin├â┬⌐s", fact: `${consolidation.examined} rapport(s) d├óΓé¼Γäóagents termin├â┬⌐s parcourus.`, evidence: "AiAgentRun ├é┬╖ r├â┬⌐sultats termin├â┬⌐s" }],
          findings: [],
          assumptions: ["Les propositions sont des brouillons soumis ├â┬á validation humaine; aucune PR n├óΓé¼Γäóest cr├â┬⌐├â┬⌐e ou fusionn├â┬⌐e automatiquement."],
          recommendations: [`${consolidation.added} proposition(s) ajout├â┬⌐e(s) ├â┬á l├óΓé¼Γäóespace de revue.`],
          missing: []
        };
        await query(`UPDATE "AiAgentRun" SET status='completed', result=$2, "finishedAt"=NOW() WHERE id=$1`, [run.id, result]);
        continue;
      }
      if (run.agentId !== "diveplan-observability") throw new Error("Aucun ex├â┬⌐cuteur n├óΓé¼Γäóest configur├â┬⌐ pour cet agent.");
      const periodHours = run.analysisPeriod === "24h" ? 24 : 168;
      const [vitals, routes, errors] = await Promise.all([
        query<Vital>(`SELECT route, metric, (SUM("ratedTotalValue") / NULLIF(SUM("ratedSamples"),0))::text AS average, SUM("ratedSamples")::text AS samples
          FROM "PerformanceTelemetryHour" WHERE hour >= NOW() - ($1::int * INTERVAL '1 hour') GROUP BY route, metric ORDER BY SUM("ratedSamples") DESC LIMIT 100`, [periodHours]),
        query<RouteVolume>(`SELECT route, SUM(requests)::text AS requests, SUM("transferBytes")::text AS bytes
          FROM "TransferTelemetryHour" WHERE hour >= NOW() - ($1::int * INTERVAL '1 hour') GROUP BY route ORDER BY SUM("transferBytes") DESC LIMIT 20`, [periodHours]),
        query<EventCount>(`SELECT type, count(*)::text AS count FROM "AppEvent"
          WHERE "createdAt" >= NOW() - ($1::int * INTERVAL '1 hour') AND type ~* '(error|exception|failed)' GROUP BY type ORDER BY count(*) DESC LIMIT 50`, [periodHours])
      ]);
      const sources = [
        { name: "PerformanceTelemetryHour", period: run.analysisPeriod, samples: vitals.rows.length },
        { name: "TransferTelemetryHour", period: run.analysisPeriod, samples: routes.rows.length },
        { name: "AppEvent (types contenant error, exception ou failed)", period: run.analysisPeriod, samples: errors.rows.length }
      ];
      const facts = [
        ...vitals.rows.map((v) => ({ category: "Web Vitals", fact: `${v.metric} moyen : ${Number(v.average).toLocaleString("fr-CA", { maximumFractionDigits: 2 })} (${v.samples} ├â┬⌐chantillons) sur ${v.route}.`, evidence: `PerformanceTelemetryHour ├é┬╖ ${v.route} ├é┬╖ ${v.metric}` })),
        ...routes.rows.slice(0, 10).map((r) => ({ category: "Volume par route", fact: `${r.route} : ${Number(r.requests).toLocaleString("fr-CA")} requ├â┬¬tes, ${formatBytes(Number(r.bytes))} transf├â┬⌐r├â┬⌐s.`, evidence: `TransferTelemetryHour ├é┬╖ ${r.route}` })),
        ...errors.rows.map((e) => ({ category: "├âΓÇ░v├â┬⌐nements signal├â┬⌐s", fact: `${e.type} : ${e.count} ├â┬⌐v├â┬⌐nements.`, evidence: `AppEvent.type=${e.type}` }))
      ];
      const assumptions = [
        "Les agr├â┬⌐gats Web Vitals ne contiennent que des moyennes et des ├â┬⌐chantillons; les percentiles et les changements historiques de code ne sont pas disponibles dans ces sources.",
        "Les ├â┬⌐v├â┬⌐nements AppEvent sont des ├â┬⌐v├â┬⌐nements applicatifs, pas un flux complet des exceptions serveur ou navigateur.",
        "Le volume de transfert indique les octets et requ├â┬¬tes par route observ├â┬⌐e, pas les temps de r├â┬⌐ponse r├â┬⌐seau ou les co├â┬╗ts d├óΓé¼Γäóh├â┬⌐bergement."
      ];
      const recommendations = [
        ...(vitals.rows.length ? ["Comparer les routes et m├â┬⌐triques les plus ├â┬⌐chantillonn├â┬⌐es avant et apr├â┬¿s un changement de code, puis profiler les routes qui se d├â┬⌐gradent."] : ["Activer et v├â┬⌐rifier la collecte de Web Vitals en production pour obtenir LCP, FCP et les autres m├â┬⌐triques."]),
        ...(routes.rows.length ? ["Examiner les routes au volume transf├â┬⌐r├â┬⌐ le plus ├â┬⌐lev├â┬⌐ et r├â┬⌐duire les payloads ou les ressources r├â┬⌐p├â┬⌐t├â┬⌐es si les donn├â┬⌐es produit le permettent."] : ["Aucun agr├â┬⌐gat de transfert n├óΓé¼Γäóest disponible pour les sept derniers jours; v├â┬⌐rifier que la collecte et la t├â┬⌐l├â┬⌐m├â┬⌐trie sont actives."]),
        ...(errors.rows.length ? ["Corr├â┬⌐ler les types d├óΓé¼Γäó├â┬⌐v├â┬⌐nements r├â┬⌐currents avec les journaux d├óΓé¼Γäóincidents avant de prioriser un correctif."] : ["Aucun ├â┬⌐v├â┬⌐nement correspondant ├â┬á error, exception ou failed n├óΓé¼Γäóa ├â┬⌐t├â┬⌐ trouv├â┬⌐; une int├â┬⌐gration d├óΓé¼Γäóerreurs d├â┬⌐di├â┬⌐e est n├â┬⌐cessaire pour mesurer leur fr├â┬⌐quence r├â┬⌐elle."]),
        "Relier Sentry ou une source de d├â┬⌐ploiements avant d├óΓé¼Γäóattribuer une r├â┬⌐gression ├â┬á une version ou ├â┬á un changement pr├â┬⌐cis."
      ];
      const result = {
        title: "Rapport d├óΓé¼Γäóobservabilit├â┬⌐ DivePlan",
        period: { from: new Date(Date.now() - periodHours * 3600000).toISOString(), to: new Date().toISOString(), label: run.analysisPeriod === "24h" ? "Derni├â┬¿res 24 heures" : "7 derniers jours" },
        sources,
        facts,
        assumptions,
        recommendations,
        missing: ["Sentry n├óΓé¼Γäóest pas consult├â┬⌐ par cet agent.", "Aucune source de d├â┬⌐ploiements ou de changements Git n├óΓé¼Γäóest connect├â┬⌐e.", "Les journaux d├óΓé¼Γäóerreurs complets ne sont pas disponibles dans AppEvent.", "Les d├â┬⌐clencheurs planifi├â┬⌐s, apr├â┬¿s d├â┬⌐ploiement et sur incident sont enregistr├â┬⌐s mais aucun producteur d├óΓé¼Γäó├â┬⌐v├â┬⌐nement n├óΓé¼Γäóest connect├â┬⌐."]
      };
      await query(`UPDATE "AiAgentRun" SET status='completed', result=$2, "finishedAt"=NOW() WHERE id=$1`, [run.id, result]);
    } catch (error) {
