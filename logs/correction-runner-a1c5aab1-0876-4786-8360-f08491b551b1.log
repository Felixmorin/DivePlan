import "server-only";
import { query, withReadOnlyDatabaseUrl, withReadOnlyTransaction } from "@/lib/db";
import { analyzeDivePlanSqlCode } from "@/lib/sql-agent-analysis";
import { runArchitectureCartography, summarizePreviousCartography } from "@/lib/architecture-agent";
import { consolidateAgentFindings } from "@/lib/pr-agent-consolidation";

type RouteVolume = { route: string; requests: string; bytes: string };
type Vital = { route: string; metric: string; average: string; samples: string };
type EventCount = { type: string; count: string };
type AgentJob = { id: string; agentId: string; analysisPeriod: "24h" | "7d"; enabled: boolean; triggers: Record<string, { enabled?: boolean }> };
type SupabaseQueryStat = { queryId: string; calls: string; rows: string; totalMs: string; meanMs: string; sharedReadBlocks: string; sharedHitBlocks: string };

export async function runNextAgentJobs(targetRunId?: string) {
  let processed = 0;
  for (let index = 0; index < (targetRunId ? 1 : 5); index += 1) {
    const claimed = await query<AgentJob>(
      `WITH candidate AS (
         SELECT r.id FROM "AiAgentRun" r
         WHERE r.status = 'pending' AND ($1::text IS NULL OR r.id = $1)
           AND (r."workflowId" IS NULL OR NOT EXISTS (
             SELECT 1 FROM "AiAgentRun" previous
             WHERE previous."workflowId"=r."workflowId" AND previous.sequence<r.sequence
               AND previous.status NOT IN ('completed','failed','cancelled')
           ))
         ORDER BY r."createdAt",r."workflowId",r.sequence FOR UPDATE SKIP LOCKED LIMIT 1
       )
       UPDATE "AiAgentRun" r SET status = 'running', "startedAt" = NOW()
       FROM candidate, "AiAgent" a
       WHERE r.id = candidate.id AND a.id = r."agentId"
      RETURNING r.id, r."agentId", r."analysisPeriod", a.enabled, a.triggers`,
      [targetRunId ?? null]
    );
    const run = claimed.rows[0];
    if (!run) break;
    processed += 1;
    try {
      if (!run.enabled || run.triggers?.onDemand?.enabled !== true) {
        await query(`UPDATE "AiAgentRun" SET status='failed', error=$2, "finishedAt"=NOW() WHERE id=$1`, [run.id, "L├óΓé¼Γäóagent ou son d├â┬⌐clenchement ├â┬á la demande a ├â┬⌐t├â┬⌐ d├â┬⌐sactiv├â┬⌐ avant le traitement."]);
        continue;
      }
      if (run.agentId === "sql-supabase-analyst") {
        const result = await runSqlSupabaseAnalysis(run.analysisPeriod);
        await query(`UPDATE "AiAgentRun" SET status='completed', result=$2, "finishedAt"=NOW() WHERE id=$1`, [run.id, result]);
        continue;
      }
      if (run.agentId === "architecture-cartographer") {
        const previousResult = await query<{ result: unknown }>(
          `SELECT result FROM "AiAgentRun" WHERE "agentId"=$1 AND status='completed' AND id<>$2 ORDER BY "createdAt" DESC LIMIT 1`, [run.agentId, run.id]
        );
        const result = await runArchitectureCartography(summarizePreviousCartography(previousResult.rows[0]?.result));
        await query(`UPDATE "AiAgentRun" SET status='completed', result=$2, "finishedAt"=NOW() WHERE id=$1`, [run.id, result]);
        continue;
      }
      if (run.agentId === "pr-consolidation") {
        const consolidation = await consolidateAgentFindings();
        const result = {
          title: "Consolidation des propositions de PR",
          period: { from: new Date().toISOString(), to: new Date().toISOString(), label: "Rapports termin├â┬⌐s disponibles" },
          sources: [{ name: "AiAgentRun", period: "Rapports termin├â┬⌐s disponibles", samples: consolidation.examined }],
          facts: [{ category: "Rapports examin├â┬⌐s", fact: `${consolidation.examined} rapport(s) d├óΓé¼Γäóagents termin├â┬⌐s parcourus.`, evidence: "AiAgentRun ├é┬╖ r├â┬⌐sultats termin├â┬⌐s" }],
          findings: [],
          assumptions: ["Les propositions sont des brouillons soumis ├â┬á validation humaine; aucune PR n├óΓé¼Γäóest cr├â┬⌐├â┬⌐e ou fusionn├â┬⌐e automatiquement."],
          recommendations: [`${consolidation.added} proposition(s) ajout├â┬⌐e(s) ├â┬á l├óΓé¼Γäóespace de revue.`],
          missing: []
        };
        await query(`UPDATE "AiAgentRun" SET status='completed', result=$2, "finishedAt"=NOW() WHERE id=$1`, [run.id, result]);
        continue;
      }
      if (run.agentId !== "diveplan-observability") throw new Error("Aucun ex├â┬⌐cuteur n├óΓé¼Γäóest configur├â┬⌐ pour cet agent.");
      const periodHours = run.analysisPeriod === "24h" ? 24 : 168;
      const [vitals, routes, errors] = await Promise.all([
        query<Vital>(`SELECT route, metric, (SUM("ratedTotalValue") / NULLIF(SUM("ratedSamples"),0))::text AS average, SUM("ratedSamples")::text AS samples
          FROM "PerformanceTelemetryHour" WHERE hour >= NOW() - ($1::int * INTERVAL '1 hour') GROUP BY route, metric ORDER BY SUM("ratedSamples") DESC LIMIT 100`, [periodHours]),
        query<RouteVolume>(`SELECT route, SUM(requests)::text AS requests, SUM("transferBytes")::text AS bytes
          FROM "TransferTelemetryHour" WHERE hour >= NOW() - ($1::int * INTERVAL '1 hour') GROUP BY route ORDER BY SUM("transferBytes") DESC LIMIT 20`, [periodHours]),
        query<EventCount>(`SELECT type, count(*)::text AS count FROM "AppEvent"
          WHERE "createdAt" >= NOW() - ($1::int * INTERVAL '1 hour') AND type ~* '(error|exception|failed)' GROUP BY type ORDER BY count(*) DESC LIMIT 50`, [periodHours])
      ]);
      const sources = [
        { name: "PerformanceTelemetryHour", period: run.analysisPeriod, samples: vitals.rows.length },
        { name: "TransferTelemetryHour", period: run.analysisPeriod, samples: routes.rows.length },
        { name: "AppEvent (types contenant error, exception ou failed)", period: run.analysisPeriod, samples: errors.rows.length }
      ];
      const facts = [
        ...vitals.rows.map((v) => ({ category: "Web Vitals", fact: `${v.metric} moyen : ${Number(v.average).toLocaleString("fr-CA", { maximumFractionDigits: 2 })} (${v.samples} ├â┬⌐chantillons) sur ${v.route}.`, evidence: `PerformanceTelemetryHour ├é┬╖ ${v.route} ├é┬╖ ${v.metric}` })),
        ...routes.rows.slice(0, 10).map((r) => ({ category: "Volume par route", fact: `${r.route} : ${Number(r.requests).toLocaleString("fr-CA")} requ├â┬¬tes, ${formatBytes(Number(r.bytes))} transf├â┬⌐r├â┬⌐s.`, evidence: `TransferTelemetryHour ├é┬╖ ${r.route}` })),
        ...errors.rows.map((e) => ({ category: "├âΓÇ░v├â┬⌐nements signal├â┬⌐s", fact: `${e.type} : ${e.count} ├â┬⌐v├â┬⌐nements.`, evidence: `AppEvent.type=${e.type}` }))
      ];
      const assumptions = [
        "Les agr├â┬⌐gats Web Vitals ne contiennent que des moyennes et des ├â┬⌐chantillons; les percentiles et les changements historiques de code ne sont pas disponibles dans ces sources.",
        "Les ├â┬⌐v├â┬⌐nements AppEvent sont des ├â┬⌐v├â┬⌐nements applicatifs, pas un flux complet des exceptions serveur ou navigateur.",
        "Le volume de transfert indique les octets et requ├â┬¬tes par route observ├â┬⌐e, pas les temps de r├â┬⌐ponse r├â┬⌐seau ou les co├â┬╗ts d├óΓé¼Γäóh├â┬⌐bergement."
      ];
      const recommendations = [
        ...(vitals.rows.length ? ["Comparer les routes et m├â┬⌐triques les plus ├â┬⌐chantillonn├â┬⌐es avant et apr├â┬¿s un changement de code, puis profiler les routes qui se d├â┬⌐gradent."] : ["Activer et v├â┬⌐rifier la collecte de Web Vitals en production pour obtenir LCP, FCP et les autres m├â┬⌐triques."]),
        ...(routes.rows.length ? ["Examiner les routes au volume transf├â┬⌐r├â┬⌐ le plus ├â┬⌐lev├â┬⌐ et r├â┬⌐duire les payloads ou les ressources r├â┬⌐p├â┬⌐t├â┬⌐es si les donn├â┬⌐es produit le permettent."] : ["Aucun agr├â┬⌐gat de transfert n├óΓé¼Γäóest disponible pour les sept derniers jours; v├â┬⌐rifier que la collecte et la t├â┬⌐l├â┬⌐m├â┬⌐trie sont actives."]),
        ...(errors.rows.length ? ["Corr├â┬⌐ler les types d├óΓé¼Γäó├â┬⌐v├â┬⌐nements r├â┬⌐currents avec les journaux d├óΓé¼Γäóincidents avant de prioriser un correctif."] : ["Aucun ├â┬⌐v├â┬⌐nement correspondant ├â┬á error, exception ou failed n├óΓé¼Γäóa ├â┬⌐t├â┬⌐ trouv├â┬⌐; une int├â┬⌐gration d├óΓé¼Γäóerreurs d├â┬⌐di├â┬⌐e est n├â┬⌐cessaire pour mesurer leur fr├â┬⌐quence r├â┬⌐elle."]),
        "Relier Sentry ou une source de d├â┬⌐ploiements avant d├óΓé¼Γäóattribuer une r├â┬⌐gression ├â┬á une version ou ├â┬á un changement pr├â┬⌐cis."
      ];
      const result = {
        title: "Rapport d├óΓé¼Γäóobservabilit├â┬⌐ DivePlan",
        period: { from: new Date(Date.now() - periodHours * 3600000).toISOString(), to: new Date().toISOString(), label: run.analysisPeriod === "24h" ? "Derni├â┬¿res 24 heures" : "7 derniers jours" },
        sources,
        facts,
        assumptions,
        recommendations,
        missing: ["Sentry n├óΓé¼Γäóest pas consult├â┬⌐ par cet agent.", "Aucune source de d├â┬⌐ploiements ou de changements Git n├óΓé¼Γäóest connect├â┬⌐e.", "Les journaux d├óΓé¼Γäóerreurs complets ne sont pas disponibles dans AppEvent.", "Les d├â┬⌐clencheurs planifi├â┬⌐s, apr├â┬¿s d├â┬⌐ploiement et sur incident sont enregistr├â┬⌐s mais aucun producteur d├óΓé¼Γäó├â┬⌐v├â┬⌐nement n├óΓé¼Γäóest connect├â┬⌐."]
      };
      await query(`UPDATE "AiAgentRun" SET status='completed', result=$2, "finishedAt"=NOW() WHERE id=$1`, [run.id, result]);
    } catch (error) {
      const message = run.agentId === "sql-supabase-analyst"
        ? "L├óΓé¼Γäóanalyse SQL a ├â┬⌐chou├â┬⌐. V├â┬⌐rifier les journaux serveur et les permissions de lecture seule."
        : redactSecrets(error instanceof Error ? error.message : "Erreur inconnue pendant l├óΓé¼Γäóanalyse.").slice(0, 1000);
      await query(`UPDATE "AiAgentRun" SET status='failed', error=$2, "finishedAt"=NOW() WHERE id=$1`, [run.id, message]);
    }
  }
  return processed;
}

function redactSecrets(message: string) {
  return [process.env.DATABASE_URL, process.env.SUPABASE_READONLY_DATABASE_URL, process.env.SUPABASE_SERVICE_ROLE_KEY, process.env.CRON_SECRET]
    .filter((secret): secret is string => Boolean(secret))
    .reduce((safe, secret) => safe.replaceAll(secret, "[secret masqu├â┬⌐]"), message);
}

async function runSqlSupabaseAnalysis(analysisPeriod: "24h" | "7d") {
  const periodHours = analysisPeriod === "24h" ? 24 : 168;
  const code = await analyzeDivePlanSqlCode();
  const egress = await withReadOnlyTransaction(async (client) => {
    const result = await client.query<{ route: string; requests: string; resultBytes: string }>(
      `SELECT route, SUM(requests)::text AS requests, SUM("resultBytes")::text AS "resultBytes"
       FROM "DatabaseEgressTelemetryHour" WHERE hour >= NOW() - ($1::int * INTERVAL '1 hour')
       GROUP BY route ORDER BY SUM("resultBytes") DESC LIMIT 20`, [periodHours]
    );
    return result.rows;
  });
  const statsConnection = process.env.SUPABASE_READONLY_DATABASE_URL;
  const queryStats = statsConnection ? await readSupabaseQueryStats(statsConnection) : null;
  const periodLabel = analysisPeriod === "24h" ? "Derni├â┬¿res 24 heures" : "7 derniers jours";
  const observed = egress.map((row) => ({
    kind: "observed" as const, priority: "medium" as const,
    impact: `${Number(row.requests).toLocaleString("fr-CA")} requ├â┬¬tes et ${formatBytes(Number(row.resultBytes))} de r├â┬⌐sultats SQL dans la t├â┬⌐l├â┬⌐m├â┬⌐trie locale.`,
    effort: "moyen" as const, title: `Egress SQL observ├â┬⌐ ├é┬╖ ${row.route}`, location: "DatabaseEgressTelemetryHour",
    evidence: `${row.requests} requ├â┬¬tes ├é┬╖ ${row.resultBytes} octets ├é┬╖ p├â┬⌐riode ${periodLabel}`,
    limits: "Mesure issue de la t├â┬⌐l├â┬⌐m├â┬⌐trie applicative enregistr├â┬⌐e; elle n├óΓé¼Γäóinclut pas n├â┬⌐cessairement tous les transferts factur├â┬⌐s par Supabase.",
    recommendation: "Examiner les routes et les appels responsables; comparer leurs r├â┬⌐sultats avant/apr├â┬¿s une optimisation."
  }));
  const queryFindings = queryStats?.rows.map((row) => ({
    kind: "observed" as const,
    priority: "medium" as const,
    impact: `${Number(row.calls).toLocaleString("fr-CA")} appels ├é┬╖ ${Number(row.totalMs).toLocaleString("fr-CA", { maximumFractionDigits: 1 })} ms cumul├â┬⌐es ├é┬╖ ${Number(row.rows).toLocaleString("fr-CA")} lignes retourn├â┬⌐es.`,
    effort: "moyen" as const,
    title: `Statistiques SQL ├é┬╖ queryid ${row.queryId}`,
    location: "pg_stat_statements",
    evidence: `queryid=${row.queryId}; appels=${row.calls}; moyenne=${Number(row.meanMs).toLocaleString("fr-CA", { maximumFractionDigits: 2 })} ms; stats_reset=${queryStats.resetAt ?? "inconnu"}; lecture blocs=${row.sharedReadBlocks}; cache blocs=${row.sharedHitBlocks}`,
    limits: "Cumul des statistiques depuis leur r├â┬⌐initialisation, sans historique par jour; le texte SQL est volontairement exclu du rapport.",
    recommendation: "Examiner la requ├â┬¬te identifi├â┬⌐e par queryid dans un outil s├â┬⌐curis├â┬⌐, puis mesurer une optimisation avec un plan d├óΓé¼Γäóex├â┬⌐cution contr├â┬┤l├â┬⌐."
  })) ?? [];
  const codeFindings = code.findings.map((finding) => ({ ...finding, priority: finding.priority, impact: finding.impact, effort: finding.effort }));
  return {
    title: "Analyse SQL & Supabase DivePlan",
    period: { from: new Date(Date.now() - periodHours * 3600000).toISOString(), to: new Date().toISOString(), label: periodLabel },
    sources: [
      { name: "Code SQL, sch├â┬⌐ma Prisma et migrations", period: "├âΓÇ░tat d├â┬⌐ploy├â┬⌐ du d├â┬⌐p├â┬┤t", samples: code.fileCount },
      { name: "DatabaseEgressTelemetryHour", period: periodLabel, samples: egress.length },
      ...(queryStats?.available ? [{ name: "pg_stat_statements", period: `Depuis ${queryStats.resetAt ?? "r├â┬⌐initialisation inconnue"} ├é┬╖ cumul global`, samples: queryStats.rows.length }] : [])
    ],
    facts: [{ category: "Inventaire du code", fact: `${code.queryCount} appels SQL extraits de ${code.fileCount} fichiers analys├â┬⌐s.`, evidence: "Scan statique des sources d├â┬⌐ploy├â┬⌐es" }, ...observed.map((finding) => ({ category: "Egress mesur├â┬⌐", fact: finding.impact, evidence: finding.evidence })), ...queryFindings.map((finding) => ({ category: "Statistiques Supabase", fact: finding.impact, evidence: finding.evidence }))],
    findings: [...observed, ...queryFindings, ...codeFindings].sort((a, b) => ({ high: 0, medium: 1, low: 2 }[a.priority] - { high: 0, medium: 1, low: 2 }[b.priority])),
    assumptions: [
      ...code.assumptions.filter((item) => !item.startsWith("Aucune int├â┬⌐gration ├â┬á l├óΓé¼ΓäóAPI de statistiques Supabase")),
      queryStats?.available
        ? "pg_stat_statements a ├â┬⌐t├â┬⌐ lu en lecture seule; ses compteurs sont cumul├â┬⌐s depuis le dernier reset, pas limit├â┬⌐s ├â┬á la p├â┬⌐riode choisie."
        : "Les statistiques pg_stat_statements ne sont pas disponibles dans cette ex├â┬⌐cution; les constats se limitent au code et ├â┬á la t├â┬⌐l├â┬⌐m├â┬⌐trie interne."
    ],
    recommendations: code.findings.slice(0, 12).map((finding) => `${finding.title} (${finding.priority} ├é┬╖ impact ${finding.impact} ├é┬╖ effort ${finding.effort}) ├óΓé¼ΓÇ¥ ${finding.recommendation}`),
    missing: [
      ...code.missing.filter((item) => !item.startsWith("Statistiques Supabase / pg_stat_statements")),
      ...(egress.length ? [] : [`Aucune ligne d├óΓé¼Γäóegress interne disponible pour ${periodLabel}; la t├â┬⌐l├â┬⌐m├â┬⌐trie peut ├â┬¬tre inactive ou vide.`]),
      ...(!statsConnection ? ["Statistiques Supabase: Configuration requise ├é┬╖ d├â┬⌐finir SUPABASE_READONLY_DATABASE_URL avec un r├â┬┤le de lecture seule."] : queryStats?.available ? [] : [queryStats?.message ?? "Connexion configur├â┬⌐e, mais pg_stat_statements est absent ou non accessible en lecture seule."])
    ]
  };
}

async function readSupabaseQueryStats(connectionString: string) {
  try {
    const hostname = new URL(connectionString).hostname;
    if (!hostname.endsWith(".supabase.co") && !hostname.endsWith(".pooler.supabase.com")) {
      return { available: false as const, rows: [] as SupabaseQueryStat[], resetAt: null, message: "SUPABASE_READONLY_DATABASE_URL doit pointer vers un h├â┬┤te PostgreSQL Supabase." };
    }
    return await withReadOnlyDatabaseUrl(connectionString, async (client) => {
      const extension = await client.query<{ schemaName: string }>(
        `SELECT n.nspname AS "schemaName" FROM pg_extension e JOIN pg_namespace n ON n.oid=e.extnamespace WHERE e.extname='pg_stat_statements' LIMIT 1`
      );
      const schemaName = extension.rows[0]?.schemaName;
      if (!schemaName) return { available: false as const, rows: [] as SupabaseQueryStat[], resetAt: null, message: "pg_stat_statements n├óΓé¼Γäóest pas install├â┬⌐e sur la base Supabase configur├â┬⌐e." };
      const columnsResult = await client.query<{ columnName: string }>(
        `SELECT column_name AS "columnName" FROM information_schema.columns WHERE table_schema=$1 AND table_name='pg_stat_statements'`, [schemaName]
      );
      const columns = new Set(columnsResult.rows.map((row) => row.columnName));
      const timeColumn = columns.has("total_exec_time") ? "total_exec_time" : columns.has("total_time") ? "total_time" : null;
      const meanColumn = columns.has("mean_exec_time") ? "mean_exec_time" : columns.has("mean_time") ? "mean_time" : null;
      if (!columns.has("queryid") || !columns.has("calls") || !columns.has("rows") || !timeColumn || !meanColumn) {
        return { available: false as const, rows: [] as SupabaseQueryStat[], resetAt: null, message: "pg_stat_statements est pr├â┬⌐sente, mais ses colonnes de lecture ne sont pas compatibles ou visibles pour ce r├â┬┤le." };
      }
      const quote = (identifier: string) => `"${identifier.replaceAll('"', '""')}"`;
      const optionalColumn = (name: string) => columns.has(name) ? `${quote(name)}::text` : "'0'::text";
      const stats = await client.query<SupabaseQueryStat>(
        `SELECT queryid::text AS "queryId", calls::text AS calls, rows::text AS rows,
          ${quote(timeColumn)}::text AS "totalMs", ${quote(meanColumn)}::text AS "meanMs",
          ${optionalColumn("shared_blks_read")} AS "sharedReadBlocks", ${optionalColumn("shared_blks_hit")} AS "sharedHitBlocks"
         FROM ${quote(schemaName)}."pg_stat_statements"
         WHERE calls > 0 ORDER BY ${quote(timeColumn)} DESC LIMIT 20`
      );
      let resetAt: string | null = null;
      const infoAvailable = await client.query<{ available: boolean }>(
        `SELECT EXISTS (SELECT 1 FROM information_schema.tables WHERE table_schema=$1 AND table_name='pg_stat_statements_info') AS available`, [schemaName]
      );
      if (infoAvailable.rows[0]?.available) {
        try {
          const reset = await client.query<{ statsReset: string | null }>(`SELECT stats_reset::text AS "statsReset" FROM ${quote(schemaName)}."pg_stat_statements_info" LIMIT 1`);
          resetAt = reset.rows[0]?.statsReset ?? null;
        } catch { /* Some provider roles can query statistics but not the reset metadata. */ }
      }
      return { available: true as const, rows: stats.rows, resetAt, message: null };
    });
  } catch {
    return { available: false as const, rows: [] as SupabaseQueryStat[], resetAt: null, message: "Connexion statistique configur├â┬⌐e, mais indisponible. V├â┬⌐rifier le r├â┬┤le en lecture seule, TLS et l├óΓé¼Γäóacc├â┬¿s ├â┬á pg_stat_statements." };
  }
}

function formatBytes(bytes: number) {
  if (!Number.isFinite(bytes) || bytes <= 0) return "0 octet";
  const units = ["octets", "Ko", "Mo", "Go"];
  const exponent = Math.min(Math.floor(Math.log(bytes) / Math.log(1024)), units.length - 1);
  return `${(bytes / 1024 ** exponent).toLocaleString("fr-CA", { maximumFractionDigits: 1 })} ${units[exponent]}`;
}
