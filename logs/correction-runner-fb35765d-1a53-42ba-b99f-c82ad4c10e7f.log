model SessionBlockAssignment {
  id             String       @id @default(cuid())
  sessionBlockId String
  athleteId      String
  sessionBlock   SessionBlock @relation(fields: [sessionBlockId], references: [id], onDelete: Cascade)
  athlete        Athlete      @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([sessionBlockId, athleteId])
}

model DrylandExercise {
  id              String                 @id @default(cuid())
  name            String
  category        String
  level           String?
  description     String
  videoUrl        String?
  defaultSets     Int?
  defaultReps     Int?
  defaultDuration Int?
  roundTrip       Boolean                @default(false)
  equipment       String?
  tags            String[]
  bodyArea        String?
  setup           String?
  coachNotes      String?
  restSeconds     Int?
  favorite        Boolean                @default(false)
  archivedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  blockExercises  DrylandBlockExercise[]
  logs            AthleteExerciseLog[]

  @@index([archivedAt, category, name])
}

model DrylandBlockExercise {
  blockId    String
  exerciseId String
  sets       Int?
  reps       Int?
  duration   Int?
  notes      String?
  order      Int
  block      SessionBlock    @relation(fields: [blockId], references: [id], onDelete: Cascade)
  exercise   DrylandExercise @relation(fields: [exerciseId], references: [id])

  @@id([blockId, order])
}

model PoolTraining {
  blockId  String        @id
  block    SessionBlock  @relation(fields: [blockId], references: [id], onDelete: Cascade)
  sections PoolSection[]
}

model PoolSection {
  id             String       @id @default(cuid())
  poolTrainingId String
  height         PoolHeight
  label          String?
  order          Int
  poolTraining   PoolTraining @relation(fields: [poolTrainingId], references: [blockId], onDelete: Cascade)
  dives          PoolDive[]

  @@index([poolTrainingId, order])
}

model PoolDive {
  id            String           @id @default(cuid())
  poolSectionId String
  diveCode      String
  diveName      String
  position      String
  repetitions   Int
  notes         String?
  postSessionModified Boolean @default(false)
  order         Int
  poolSection   PoolSection      @relation(fields: [poolSectionId], references: [id], onDelete: Cascade)
  logs          AthleteDiveLog[]
  athleteNotes  AthleteDiveNote[]
}

