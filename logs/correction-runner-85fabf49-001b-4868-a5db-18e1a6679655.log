      }
      if (/\b(for|while)\s*\([^)]*\)\s*\{[\s\S]{0,700}$/i.test(call.context) || /\.map\s*\([^)]*=>\s*(?:query|.*\.query)\s*\(/i.test(call.context)) {
        findings.push({ kind: "code", priority: "high", impact: "Une requ├â┬¬te r├â┬⌐p├â┬⌐t├â┬⌐e dans une boucle peut multiplier les allers-retours (N+1).", effort: "moyen", title: "Acc├â┬¿s SQL potentiellement r├â┬⌐p├â┬⌐t├â┬⌐ dans une boucle", location, evidence: "Un appel SQL est pr├â┬⌐c├â┬⌐d├â┬⌐ d├óΓé¼Γäóune boucle dans le m├â┬¬me contexte source.", limits: "La proximit├â┬⌐ textuelle est une heuristique; elle ne prouve pas que l├óΓé¼Γäóappel est ex├â┬⌐cut├â┬⌐ ├â┬á chaque it├â┬⌐ration.", recommendation: "V├â┬⌐rifier le chemin d├óΓé¼Γäóex├â┬⌐cution et envisager une jointure, une requ├â┬¬te group├â┬⌐e ou un chargement par lots." });
      }
    }
  }
  for (const [sql, locations] of normalizedQueries) {
    if (locations.length < 2 || !/\b(select|insert|update|delete)\b/.test(sql)) continue;
    findings.push({ kind: "code", priority: "medium", impact: "Des instructions identiques pr├â┬⌐sentes ├â┬á plusieurs endroits peuvent r├â┬⌐p├â┬⌐ter le m├â┬¬me acc├â┬¿s selon le chemin utilisateur.", effort: "faible", title: "Instruction SQL dupliqu├â┬⌐e dans le code", location: locations.slice(0, 6).join(" ├é┬╖ "), evidence: `${locations.length} occurrences normalis├â┬⌐es de la m├â┬¬me instruction SQL.`, limits: "La duplication du texte ne prouve pas que les appels s├óΓé¼Γäóex├â┬⌐cutent ensemble ni qu├óΓé¼Γäóils provoquent des requ├â┬¬tes r├â┬⌐p├â┬⌐t├â┬⌐es ├â┬á l├óΓé¼Γäóex├â┬⌐cution.", recommendation: "V├â┬⌐rifier si les appels sont redondants; mutualiser ou regrouper le chargement uniquement si les traces le confirment." });
  }

  const sessionFiles = files.filter((file) => file.path.includes("src/app/coach/sessions/") || file.path.includes("src/lib/coach-session"));
  const sessionQueries = sessionFiles.flatMap((file) => extractQueries(file.content).map((call) => ({ file, call })));
  if (sessionQueries.length) {
    const loopCandidates = sessionFiles.flatMap((file) => {
      const lines = file.content.split("\n");
      return lines.flatMap((line, index) => /\b(?:for|while)\s*\(|\.map\s*\(/.test(line) && lines.slice(index, index + 16).some((nearby) => /\bquery\s*\(|\.query\s*\(/.test(nearby)) ? [`${file.path}:${index + 1}`] : []);
    });
    const loopEvidence = loopCandidates.length ? `; appels proches d├óΓé¼Γäóune boucle rep├â┬⌐r├â┬⌐s ├â┬á ${loopCandidates.slice(0, 4).join(", ")}` : "";
    findings.push({ kind: "hypothesis", priority: loopCandidates.length ? "high" : "medium", impact: "Le d├â┬⌐tail de s├â┬⌐ance assemble plusieurs donn├â┬⌐es; le co├â┬╗t total d├â┬⌐pend du volume de relations et des acc├â┬¿s ex├â┬⌐cut├â┬⌐s par branche.", effort: "moyen", title: "V├â┬⌐rifier le co├â┬╗t SQL du d├â┬⌐tail de s├â┬⌐ance", location: "src/app/coach/sessions/[id]/page.tsx ├é┬╖ src/lib/coach-session.ts", evidence: `${sessionQueries.length} appels SQL extraits des fichiers de s├â┬⌐ances${loopEvidence}.`, limits: "Le nombre effectif d├óΓé¼Γäóappels, les octets et la dur├â┬⌐e ne sont pas mesur├â┬⌐s par cette analyse du code.", recommendation: "Comparer les appels et volumes en production; regrouper les chargements r├â┬⌐p├â┬⌐titifs si les traces confirment un N+1." });
  }
  findings.push({ kind: "hypothesis", priority: "low", impact: "Un index adapt├â┬⌐ peut r├â┬⌐duire les lectures pour les filtres et tris fr├â┬⌐quents.", effort: "moyen", title: "Valider les index avec les plans de requ├â┬¬te", location: "prisma/schema.prisma ├é┬╖ migrations SQL", evidence: "Le d├â┬⌐p├â┬┤t contient le sch├â┬⌐ma Prisma et les migrations; aucun plan EXPLAIN ni statistique exploitable de requ├â┬¬tes n├óΓé¼Γäóest fourni ├â┬á l├óΓé¼Γäóagent.", limits: "Aucun index manquant ou inutile ne peut ├â┬¬tre confirm├â┬⌐ sans plans, cardinalit├â┬⌐s et charge repr├â┬⌐sentative.", recommendation: "Examiner EXPLAIN (ANALYZE, BUFFERS) sous contr├â┬┤le humain et comparer les index aux filtres r├â┬⌐ellement observ├â┬⌐s avant toute migration." });
  findings.push({ kind: "hypothesis", priority: "low", impact: "Un index inutilis├â┬⌐ peut ajouter du co├â┬╗t aux ├â┬⌐critures et consommer de l├óΓé¼Γäóespace disque.", effort: "moyen", title: "Usage r├â┬⌐el des index non observ├â┬⌐", location: "Statistiques PostgreSQL ├é┬╖ pg_stat_user_indexes", evidence: "Aucune statistique d├óΓé¼Γäóutilisation d├óΓé¼Γäóindex n├óΓé¼Γäóest accessible ├â┬á l├óΓé¼Γäóagent dans la configuration actuelle.", limits: "Un index sans lecture observ├â┬⌐e sur une courte fen├â┬¬tre peut rester utile pour des charges rares ou apr├â┬¿s red├â┬⌐marrage des compteurs.", recommendation: "Comparer idx_scan et les lectures sur une p├â┬⌐riode repr├â┬⌐sentative avec un acc├â┬¿s de statistiques en lecture seule avant de proposer sa suppression." });
  findings.push({ kind: "hypothesis", priority: "low", impact: "Les param├â┬¿tres de pool et les politiques RLS peuvent affecter latence, connexions et isolation.", effort: "moyen", title: "V├â┬⌐rifier pooler et politiques RLS dans l├óΓé¼Γäóenvironnement", location: "src/lib/db.ts ├é┬╖ configuration Supabase", evidence: "Le pool applicatif limite chaque instance ├â┬á trois connexions; aucune politique RLS ni API de gestion Supabase n├óΓé¼Γäóest consult├â┬⌐e par l├óΓé¼Γäóagent.", limits: "La configuration effective, le pooler distant et les politiques de production ne sont pas lisibles dans le d├â┬⌐p├â┬┤t.", recommendation: "Comparer la cha├â┬«ne de connexion au pooler recommand├â┬⌐ et auditer les politiques RLS depuis un r├â┬┤le autoris├â┬⌐ en lecture seule." });
  if (queryCount === 0) findings.push({ kind: "hypothesis", priority: "low", impact: "Le scan SQL n├óΓé¼Γäóa pas pu examiner d├óΓé¼Γäóappels SQL.", effort: "faible", title: "Aucun appel SQL d├â┬⌐tect├â┬⌐", location: "src/app ├é┬╖ src/lib ├é┬╖ migrations", evidence: "Aucun appel `query(...)` contenant une instruction SQL n├óΓé¼Γäóa ├â┬⌐t├â┬⌐ extrait.", limits: "Les requ├â┬¬tes construites dynamiquement ou encapsul├â┬⌐es dans d├óΓé¼Γäóautres abstractions peuvent ├â┬⌐chapper au scan.", recommendation: "V├â┬⌐rifier les sources d├â┬⌐ploy├â┬⌐es et les abstractions de base de donn├â┬⌐es utilis├â┬⌐es." });
  const assumptions = [
    "Les constats de code sont issus de motifs textuels et ne repr├â┬⌐sentent pas des plans d├óΓé¼Γäóex├â┬⌐cution ni des mesures de dur├â┬⌐e.",
    "Aucune int├â┬⌐gration ├â┬á l├óΓé¼ΓäóAPI de statistiques Supabase, ├â┬á pg_stat_statements ou aux politiques RLS n├óΓé¼Γäóest configur├â┬⌐e; le rapport ne pr├â┬⌐sente pas ces donn├â┬⌐es comme observ├â┬⌐es.",
    "La connexion de l├óΓé¼Γäóapplication est utilis├â┬⌐e seulement dans une transaction PostgreSQL READ ONLY pour lire les agr├â┬⌐gats de t├â┬⌐l├â┬⌐m├â┬⌐trie; la file et le rapport sont ├â┬⌐crits s├â┬⌐par├â┬⌐ment par le worker."
  ];
  const missing = [
    "Statistiques Supabase / pg_stat_statements: configuration requise (acc├â┬¿s SQL en lecture seule et extension/permissions disponibles).",
    "L├óΓé¼Γäóagent ne peut ni modifier la base, ni appliquer des migrations, ni fusionner une PR ou d├â┬⌐ployer."
  ];
  if (options.unavailableRoots?.length) missing.push(`Sources non disponibles dans l├óΓé¼Γäóenvironnement du worker: ${options.unavailableRoots.join(", ")}.`);
  if (options.truncated) missing.push("Le nombre maximal de fichiers du scan a ├â┬⌐t├â┬⌐ atteint; l├óΓé¼Γäóinventaire peut ├â┬¬tre incomplet.");
  return { queryCount, findings, assumptions, missing };
}

function readSchemaIndexFields(schema: string) {
  const indexFields = new Map<string, Set<string>>();
  for (const model of schema.matchAll(/model\s+(\w+)\s*\{([\s\S]*?)\n\}/g)) {
    const fields = new Set<string>();
    for (const line of model[2].split("\n")) {
      const field = line.match(/^\s*(\w+)\s+[^\s]+.*@(id|unique)\b/);
      if (field) fields.add(field[1]);
    }
    for (const index of model[2].matchAll(/@@(?:id|unique|index)\s*\(\s*\[([^\]]+)\]/g)) {
      for (const field of index[1].matchAll(/\b(\w+)\b/g)) fields.add(field[1]);
    }
    indexFields.set(model[1], fields);
  }
  return indexFields;
}

export async function analyzeDivePlanSqlCode(root = process.cwd()) {
  const loaded = await loadDivePlanSources(root);
  const analysis = analyzeSqlSourceFiles(loaded.files, loaded);
  return { ...analysis, fileCount: loaded.files.length };
}
import assert from "node:assert/strict";
import test from "node:test";
import { analyzeSqlSourceFiles } from "@/lib/sql-agent-analysis";

test("flags broad and unpaginated SQL while preserving the source location", () => {
  const report = analyzeSqlSourceFiles([{ path: "src/lib/example.ts", content: 'await query(`SELECT * FROM "TrainingSession"`);' }]);
  assert.equal(report.queryCount, 1);
  assert.ok(report.findings.some((finding) => finding.title === "SELECT * dans une requ├â┬¬te" && finding.location === "src/lib/example.ts:1"));
  assert.ok(report.findings.some((finding) => finding.title === "Lecture sans pagination visible"));
});

test("does not flag the unnest projection used to expand parameter arrays", () => {
  const report = analyzeSqlSourceFiles([{ path: "src/lib/bulk.ts", content: 'await query(`SELECT * FROM unnest($1::text[])`);' }]);
  assert.equal(report.queryCount, 1);
  assert.equal(report.findings.some((finding) => finding.title === "SELECT * dans une requ├â┬¬te"), false);
});

test("does not present missing index evidence as a confirmed measurement", () => {
  const report = analyzeSqlSourceFiles([{ path: "src/lib/example.ts", content: 'await query(`SELECT id FROM "User" LIMIT 10`);' }]);
  const indexFinding = report.findings.find((finding) => finding.title === "Valider les index avec les plans de requ├â┬¬te");
  assert.equal(indexFinding?.kind, "hypothesis");
  assert.match(indexFinding?.limits ?? "", /Aucun index manquant/);
});

test("reports duplicated SQL as a code finding rather than an observed repeat", () => {
  const sql = 'await query(`SELECT id FROM "User" WHERE id = $1`);';
  const report = analyzeSqlSourceFiles([
    { path: "src/lib/first.ts", content: sql },
    { path: "src/lib/second.ts", content: sql }
  ]);
  const duplicate = report.findings.find((finding) => finding.title === "Instruction SQL dupliqu├â┬⌐e dans le code");
  assert.equal(duplicate?.kind, "code");
  assert.match(duplicate?.limits ?? "", /ne prouve pas/);
});

test("marks an unindexed filter as a hypothesis when the Prisma schema has no matching index", () => {
  const report = analyzeSqlSourceFiles([
    { path: "prisma/schema.prisma", content: "model TrainingSession {\n id String @id\n title String\n @@index([id])\n}" },
    { path: "src/lib/example.ts", content: 'await query(`SELECT id FROM "TrainingSession" WHERE title = $1 LIMIT 1`);' }
  ]);
  const candidate = report.findings.find((finding) => finding.title === "Piste d├óΓé¼Γäóindex ├â┬á v├â┬⌐rifier ├é┬╖ TrainingSession.title");
  assert.equal(candidate?.kind, "hypothesis");
  assert.match(candidate?.limits ?? "", /La base peut avoir un index cr├â┬⌐├â┬⌐ hors Prisma/);
});
