        )).rows[0];
        groupId = group.id;
      }

      const existing = await tx.query<{ id: string }>(
        `SELECT a.id FROM "User" u LEFT JOIN "Athlete" a ON a."userId" = u.id WHERE u.email = $1 LIMIT 1`, [record.email]
