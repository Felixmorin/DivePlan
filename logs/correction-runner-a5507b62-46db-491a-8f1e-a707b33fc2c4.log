         RETURNING id`, [randomUUID(), record.firstName, record.lastName, record.email, USER_ROLE_ATHLETE, clubId]
      );
      const userId = account.rows[0].id;
      await tx.query(
        `INSERT INTO "Athlete" (id, "userId", "clubId", "groupId", "birthDate", level, active)
