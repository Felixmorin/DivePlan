  57: export async function getSessionSnapshot(sessionId:string,clubId:string):Promise<SessionSnapshot|null>{
  58:  const base=(await query<SessionSnapshot>("SELECT s.*, row_to_json(w) AS week FROM \"TrainingSession\" s JOIN \"TrainingWeek\" w ON w.id=s.\"weekId\" WHERE s.id=$1 AND w.\"clubId\"=$2",[sessionId,clubId])).rows[0]; if(!base)return null;
  59:  const blocks=(await query<Block>("SELECT * FROM \"SessionBlock\" WHERE \"sessionId\"=$1 ORDER BY position",[sessionId])).rows;
  60:  const blockIds=blocks.map(b=>b.id);
  61:  const [assignments,drylandExercises,pools,sections]=await Promise.all([
  62:   query<Assignment>("SELECT * FROM \"SessionBlockAssignment\" WHERE \"sessionBlockId\"=ANY($1::text[])",[blockIds]),
  63:   query<Dryland>("SELECT * FROM \"DrylandBlockExercise\" WHERE \"blockId\"=ANY($1::text[]) ORDER BY \"order\"",[blockIds]),
  64:   query<{blockId:string}>("SELECT \"blockId\" FROM \"PoolTraining\" WHERE \"blockId\"=ANY($1::text[])",[blockIds]),
  65:   query<Section>("SELECT * FROM \"PoolSection\" WHERE \"poolTrainingId\"=ANY($1::text[]) ORDER BY \"order\"",[blockIds])
  66:  ]);
  67:  const sectionIds=sections.rows.map(s=>s.id);
  68:  const dives=await query<Dive>("SELECT * FROM \"PoolDive\" WHERE \"poolSectionId\"=ANY($1::text[]) ORDER BY \"order\"",[sectionIds]);
  69:  const assignmentsByBlock=new Map<string,Assignment[]>(),drylandByBlock=new Map<string,Dryland[]>(),sectionsByBlock=new Map<string,Section[]>(),divesBySection=new Map<string,Dive[]>();
  70:  for(const row of assignments.rows){const rows=assignmentsByBlock.get(row.sessionBlockId)??[];rows.push(row);assignmentsByBlock.set(row.sessionBlockId,rows);}
  71:  for(const row of drylandExercises.rows){const rows=drylandByBlock.get(row.blockId)??[];rows.push(row);drylandByBlock.set(row.blockId,rows);}
  72:  for(const row of sections.rows){const rows=sectionsByBlock.get(row.poolTrainingId)??[];rows.push(row);sectionsByBlock.set(row.poolTrainingId,rows);}
  73:  for(const row of dives.rows){const rows=divesBySection.get(row.poolSectionId)??[];rows.push(row);divesBySection.set(row.poolSectionId,rows);}
  74:  const poolBlockIds=new Set(pools.rows.map(pool=>pool.blockId));
  75:  for(const b of blocks){
  76:   b.assignments=assignmentsByBlock.get(b.id)??[];
  77:   b.drylandExercises=drylandByBlock.get(b.id)??[];
  78:   b.poolTraining=poolBlockIds.has(b.id)?{blockId:b.id,sections:(sectionsByBlock.get(b.id)??[]).map(s=>({...s,dives:divesBySection.get(s.id)??[]}))}:null;
  79:  }
  80:  return {...base,week:typeof base.week==="string"?JSON.parse(base.week):base.week,blocks};
  81: }
