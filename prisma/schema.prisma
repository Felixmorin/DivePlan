generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  COACH
  ATHLETE
}

enum WeekStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SessionStatus {
  DRAFT
  READY
  IN_PROGRESS
  COMPLETED
  NOT_DONE
  CANCELLED
}

enum BlockType {
  WARMUP
  DRYLAND
  POOL
  COOLDOWN
  CUSTOM
}

enum PoolHeight {
  ONE_METER
  THREE_METER
  PLATFORM
  CUSTOM
}

enum CompetitionEvaluationAuthor {
  ATHLETE
  COACH
}

enum CompetitionDiveStatus {
  READY
  TO_WORK_ON
  DIFFICULT
  NOT_READY
}

enum SkillStatus {
  NOT_STARTED
  LEARNING
  DEVELOPING
  MASTERED
}

enum CompletionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum PlanningEventType {
  COMPETITION
  CAMP
  TRAINING_SCHEDULE
}

model Club {
  id             String            @id @default(cuid())
  name           String
  logo           String?
  createdAt      DateTime          @default(now())
  users          User[]
  athletes       Athlete[]
  coaches        Coach[]
  groups         TrainingGroup[]
  weeks          TrainingWeek[]
  events         AppEvent[]
  templates      SessionTemplate[]
  planningEvents PlanningEvent[]
  milestones     ClubMilestone[]
  transferTelemetry TransferTelemetryHour[]
  databaseEgressTelemetry DatabaseEgressTelemetryHour[]
  performanceTelemetry PerformanceTelemetryHour[]
}

model AiAgent {
  id        String        @id
  name      String
  mission   String
  enabled   Boolean       @default(true)
  sortOrder Int           @default(0)
  triggers  Json           @default("{\"onDemand\":{\"enabled\":true},\"schedule\":{\"enabled\":false,\"cron\":\"0 9 * * 1\"},\"afterDeploy\":{\"enabled\":false},\"incident\":{\"enabled\":false}}")
  createdAt DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt DateTime      @default(now()) @db.Timestamptz(6)
  runs      AiAgentRun[]
}

model AiAgentRun {
  id          String   @id
  agentId     String
  trigger     String
  status      String   @default("pending")
  startedAt   DateTime? @db.Timestamptz(6)
  finishedAt  DateTime? @db.Timestamptz(6)
  result      Json?
  error       String?
  createdById String?
  analysisPeriod String   @default("7d")
  workflowId  String?
  sequence    Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  agent       AiAgent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([agentId, createdAt(sort: Desc)])
  @@index([workflowId, sequence])
}

model TransferTelemetryHour {
  clubId        String
  hour          DateTime @db.Timestamptz(6)
  route         String
  resourceType  String
  requests      Int      @default(0)
  transferBytes BigInt   @default(0)
  cacheHits     Int      @default(0)
  updatedAt     DateTime @default(now()) @db.Timestamptz(6)
  club          Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@id([clubId, hour, route, resourceType])
  @@index([clubId, hour(sort: Desc)])
}

model DatabaseEgressTelemetryHour {
  clubId        String
  hour          DateTime @db.Timestamptz(6)
  route         String
  component     String   @default("other")
  requests      Int      @default(0)
  resultBytes   BigInt   @default(0)
  durationMs    Float    @default(0) @db.DoublePrecision
  maxDurationMs Float    @default(0) @db.DoublePrecision
  slowQueries   Int      @default(0)
  updatedAt     DateTime @default(now()) @db.Timestamptz(6)
  club          Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@id([clubId, hour, route, component])
  @@index([clubId, hour(sort: Desc)])
}

model PerformanceTelemetryHour {
  clubId     String
  hour       DateTime @db.Timestamptz(6)
  route      String
  metric     String
  samples    Int      @default(0)
  totalValue Float    @default(0) @db.DoublePrecision
  maxValue   Float    @default(0) @db.DoublePrecision
  updatedAt  DateTime @default(now()) @db.Timestamptz(6)
  club       Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@id([clubId, hour, route, metric])
  @@index([clubId, hour(sort: Desc)])
}

model ClubMilestone {
  clubId      String
  key         String
  title       String
  description String
  club        Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@id([clubId, key])
}

model User {
  id            String     @id @default(cuid())
  firstName     String
  lastName      String
  email         String     @unique
  username      String?    @unique
  role          UserRole
  passwordHash  String?
  passwordSetAt DateTime?
  accessEnabled Boolean    @default(true)
  avatar        String?
  clubId        String?
  createdAt     DateTime   @default(now())
  club          Club?      @relation(fields: [clubId], references: [id])
  athlete       Athlete?
  coach         Coach?
  events        AppEvent[]
  agentRuns     AiAgentRun[]
  pushSubscriptions PushSubscription[]
  pushDeliveries PushDelivery[]
  sessionUpdateDeliveries SessionUpdatePushDelivery[]
  sessionCancellationDeliveries SessionCancellationPushDelivery[]
  planningEventCancellationDeliveries PlanningEventCancellationPushDelivery[]
  planningEventDeliveries PlanningEventPushDelivery[]
  featureAccess CoachFeatureAccess[]
}

model CoachFeatureAccess {
  userId    String
  featureId String
  enabled   Boolean  @default(false)
  updatedAt DateTime @default(now()) @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, featureId])
  @@index([featureId])
}

model AppEvent {
  id        String   @id @default(cuid())
  clubId    String?
  userId    String?
  type      String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())
  club      Club?    @relation(fields: [clubId], references: [id], onDelete: SetNull)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clubId, createdAt])
  @@index([type, createdAt])
}

model Athlete {
  id               String                     @id @default(cuid())
  userId           String                     @unique
  clubId           String
  groupId          String?
  birthDate        DateTime
  level            String
  active           Boolean                    @default(true)
  user             User                       @relation(fields: [userId], references: [id])
  club             Club                       @relation(fields: [clubId], references: [id])
  group            TrainingGroup?             @relation(fields: [groupId], references: [id])
  assignments      SessionBlockAssignment[]
  completions      AthleteSessionCompletion[]
  absences         AthleteSessionAbsence[]
  diveLogs         AthleteDiveLog[]
  diveNotes        AthleteDiveNote[]
  coachSessionNotes CoachAthleteSessionNote[]
  exerciseLogs     AthleteExerciseLog[]
  skills           AthleteSkill[]
  planningEvents   PlanningEvent[]
  competitionDives CompetitionDive[]
  competitionDiveLists CompetitionDiveList[]
  competitionDiveEvaluations AthleteCompetitionDiveEvaluation[]
  milestones       AthleteMilestone[]
}

model AthleteMilestone {
  id          String   @id @default(cuid())
  athleteId   String
  key         String
  awardedAt   DateTime @default(now())
  athlete     Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([athleteId, key])
  @@index([key, awardedAt])
}

model CompetitionDiveList {
  id         String            @id @default(cuid())
  athleteId  String
  name       String
  position   Int               @default(0)
  heights    PoolHeight[]      @default([])
  createdAt  DateTime          @default(now())
  athlete    Athlete           @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  dives      CompetitionDive[]

  @@unique([athleteId, name])
  @@index([athleteId, position])
}

model CompetitionDive {
  id         String     @id @default(cuid())
  athleteId  String
  listId     String
  height     PoolHeight
  platformHeight Float?
  diveCode   String
  diveName   String
  difficulty Float?
  status     CompetitionDiveStatus @default(NOT_READY)
  position   Int        @default(0)
  createdAt  DateTime   @default(now())
  athlete    Athlete    @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  list       CompetitionDiveList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([athleteId, listId, height, position])
}

model Coach {
  id                    String            @id @default(cuid())
  userId                String            @unique
  clubId                String
  planningDefaultView   String            @default("week")
  weekStartsOn          Int               @default(1)
  printShowCoachNotes   Boolean           @default(true)
  printShowAthleteNames Boolean           @default(true)
  printRepetitionChecks Boolean           @default(false)
  user                  User              @relation(fields: [userId], references: [id])
  club                  Club              @relation(fields: [clubId], references: [id])
  groups                TrainingGroup[]
  sessions              TrainingSession[]
  competitionDiveEvaluations AthleteCompetitionDiveEvaluation[]
}

model PushSubscription {
  id        String   @id
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  lastTestAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
}

model PushDelivery {
  id        String   @id
  sessionId String
  userId    String
  status    String   @default("PENDING")
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  sentAt    DateTime?
  lastError String?
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([sessionId, userId])
  @@index([status, createdAt])
}

model SessionUpdatePushDelivery {
  id        String         @id
  updateId  String
  sessionId String
  userId    String
  status    String         @default("PENDING")
  attempts  Int            @default(0)
  createdAt DateTime       @default(now())
  sentAt    DateTime?
  lastError String?
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([updateId, userId])
  @@index([status, createdAt])
}

model SessionCancellationPushDelivery {
  id        String   @id
  sessionId String
  userId    String
  status    String   @default("PENDING")
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  sentAt    DateTime?
  lastError String?
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([sessionId, userId])
  @@index([status, createdAt])
}

model PlanningEventCancellationPushDelivery {
  id              String        @id
  planningEventId String
  userId          String
  status          String        @default("PENDING")
  attempts        Int           @default(0)
  createdAt       DateTime      @default(now())
  sentAt          DateTime?
  lastError       String?
  planningEvent   PlanningEvent @relation(fields: [planningEventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([planningEventId, userId])
  @@index([status, createdAt])
}

model PlanningEventPushDelivery {
  id              String        @id
  planningEventId String
  userId          String
  status          String        @default("PENDING")
  attempts        Int           @default(0)
  createdAt       DateTime      @default(now())
  sentAt          DateTime?
  lastError       String?
  planningEvent   PlanningEvent @relation(fields: [planningEventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([planningEventId, userId])
  @@index([status, createdAt])
}

model TrainingGroup {
  id             String          @id @default(cuid())
  name           String
  clubId         String
  coachId        String
  club           Club            @relation(fields: [clubId], references: [id])
  coach          Coach           @relation(fields: [coachId], references: [id])
  athletes       Athlete[]
  weeks          TrainingWeek[]
  planningEvents PlanningEvent[]
}

model PlanningEvent {
  id        String            @id @default(cuid())
  clubId    String
  groupId   String?
  athleteId String?
  type      PlanningEventType
  title     String
  startsAt  DateTime
  endsAt    DateTime?
  duration  Int?
  location  String?
  notes     String?
  cancelledAt DateTime?
  calendarHiddenAt DateTime?
  coachCalendarHiddenAt DateTime?
  createdAt DateTime          @default(now())
  club      Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  group     TrainingGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  athlete   Athlete?          @relation(fields: [athleteId], references: [id], onDelete: SetNull)
  session   TrainingSession?
  cancellationPushDeliveries PlanningEventCancellationPushDelivery[]
  pushDeliveries PlanningEventPushDelivery[]

  @@index([clubId, startsAt])
  @@index([groupId, startsAt])
  @@index([athleteId, startsAt])
}

model TrainingWeek {
  id        String            @id @default(cuid())
  clubId    String
  groupId   String
  startDate DateTime
  title     String
  status    WeekStatus        @default(DRAFT)
  club      Club              @relation(fields: [clubId], references: [id])
  group     TrainingGroup     @relation(fields: [groupId], references: [id])
  sessions  TrainingSession[]
}

model TrainingSession {
  id              String                     @id @default(cuid())
  date            DateTime
  title           String
  duration        Int
  notes           String?
  weekId          String
  coachId         String
  status          SessionStatus              @default(DRAFT)
  calendarHiddenAt DateTime?
  planningEventId String?                    @unique
  competitionEvaluationAtStart Boolean        @default(false)
  week            TrainingWeek               @relation(fields: [weekId], references: [id])
  coach           Coach                      @relation(fields: [coachId], references: [id])
  blocks          SessionBlock[]
  completions     AthleteSessionCompletion[]
  absences        AthleteSessionAbsence[]
  diveLogs        AthleteDiveLog[]
  exerciseLogs    AthleteExerciseLog[]
  templates       SessionTemplate[]
  planningEvent   PlanningEvent?             @relation(fields: [planningEventId], references: [id], onDelete: SetNull)
  competitionDiveEvaluations AthleteCompetitionDiveEvaluation[]
  pushDeliveries PushDelivery[]
  updatePushDeliveries SessionUpdatePushDelivery[]
  cancellationPushDeliveries SessionCancellationPushDelivery[]
  coachAthleteNotes CoachAthleteSessionNote[]
}

model CoachAthleteSessionNote {
  sessionId String
  athleteId String
  note      String
  updatedAt DateTime        @updatedAt
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  athlete   Athlete         @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@id([sessionId, athleteId])
  @@index([athleteId])
}

model SessionBlock {
  id               String                   @id @default(cuid())
  sessionId        String
  type             BlockType
  title            String
  description      String?
  duration         Int
  position         Int
  estimatedVolume  Int                      @default(0)
  competitionEvaluation Boolean              @default(false)
  session          TrainingSession          @relation(fields: [sessionId], references: [id])
  assignments      SessionBlockAssignment[]
  drylandExercises DrylandBlockExercise[]
  poolTraining     PoolTraining?
}

model AthleteCompetitionDiveEvaluation {
  id                String          @id @default(cuid())
  athleteId         String
  sessionId         String?
  coachId           String?
  competitionDiveId String
  diveCode          String
  height            PoolHeight
  rating            Int
  evaluator         CompetitionEvaluationAuthor @default(ATHLETE)
  evaluatedAt       DateTime        @default(now())
  athlete           Athlete         @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  session           TrainingSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  coach             Coach?          @relation(fields: [coachId], references: [id], onDelete: SetNull)

  @@unique([athleteId, sessionId, competitionDiveId], map: "AthleteCompDiveEval_athlete_session_dive_key")
  @@index([athleteId, competitionDiveId, evaluatedAt], map: "AthleteCompDiveEval_athlete_dive_time_idx")
  @@index([sessionId], map: "AthleteCompDiveEval_session_idx")
  @@index([athleteId, evaluator, evaluatedAt], map: "AthleteCompDiveEval_subject_author_time_idx")
}

model SessionBlockAssignment {
  id             String       @id @default(cuid())
  sessionBlockId String
  athleteId      String
  sessionBlock   SessionBlock @relation(fields: [sessionBlockId], references: [id], onDelete: Cascade)
  athlete        Athlete      @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([sessionBlockId, athleteId])
}

model DrylandExercise {
  id              String                 @id @default(cuid())
  name            String
  category        String
  level           String?
  description     String
  videoUrl        String?
  defaultSets     Int?
  defaultReps     Int?
  defaultDuration Int?
  roundTrip       Boolean                @default(false)
  equipment       String?
  tags            String[]
  bodyArea        String?
  setup           String?
  coachNotes      String?
  restSeconds     Int?
  favorite        Boolean                @default(false)
  archivedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  blockExercises  DrylandBlockExercise[]
  logs            AthleteExerciseLog[]

  @@index([archivedAt, category, name])
}

model DrylandBlockExercise {
  blockId    String
  exerciseId String
  sets       Int?
  reps       Int?
  duration   Int?
  notes      String?
  order      Int
  block      SessionBlock    @relation(fields: [blockId], references: [id], onDelete: Cascade)
  exercise   DrylandExercise @relation(fields: [exerciseId], references: [id])

  @@id([blockId, order])
}

model PoolTraining {
  blockId  String        @id
  block    SessionBlock  @relation(fields: [blockId], references: [id], onDelete: Cascade)
  sections PoolSection[]
}

model PoolSection {
  id             String       @id @default(cuid())
  poolTrainingId String
  height         PoolHeight
  label          String?
  order          Int
  poolTraining   PoolTraining @relation(fields: [poolTrainingId], references: [blockId], onDelete: Cascade)
  dives          PoolDive[]

  @@index([poolTrainingId, order])
}

model PoolDive {
  id            String           @id @default(cuid())
  poolSectionId String
  diveCode      String
  diveName      String
  position      String
  repetitions   Int
  notes         String?
  postSessionModified Boolean @default(false)
  order         Int
  poolSection   PoolSection      @relation(fields: [poolSectionId], references: [id], onDelete: Cascade)
  logs          AthleteDiveLog[]
  athleteNotes  AthleteDiveNote[]
}

model SessionTemplate {
  id        String           @id @default(cuid())
  name      String
  category  String
  sessionId String?
  clubId    String
  favorite  Boolean          @default(false)
  payload   Json
  session   TrainingSession? @relation(fields: [sessionId], references: [id])
  club      Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId, favorite, name])
  @@index([sessionId])
}

model Skill {
  id            String         @id @default(cuid())
  name          String
  code          String         @unique
  category      String
  height        String
  prerequisites String[]
  athleteSkills AthleteSkill[]
}

model AthleteSkill {
  athleteId   String
  skillId     String
  level       Int
  progress    Int
  status      SkillStatus
  trainings   Int         @default(0)
  repetitions Int         @default(0)
  athlete     Athlete     @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  skill       Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([athleteId, skillId])
}

model AthleteSessionCompletion {
  athleteId   String
  sessionId   String
  startedAt   DateTime?
  completedAt DateTime?
  status      CompletionStatus @default(NOT_STARTED)
  rating      String?
  note        String?
  athlete     Athlete          @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  session     TrainingSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([athleteId, sessionId])
}

model AthleteSessionAbsence {
  athleteId String
  sessionId String
  createdAt DateTime @default(now())
  athlete   Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([athleteId, sessionId])
  @@index([sessionId])
}

model AthleteDiveLog {
  id                   String          @id @default(cuid())
  athleteId            String
  sessionId            String
  poolDiveId           String
  familyOverride       String?
  actualDiveCode       String?
  actualDiveName       String?
  repetitionsCompleted Int
  goldenRepetitions    Int               @default(0)
  feedbackCompleted   Boolean           @default(false)
  rating               String
  note                 String?
  timestamp            DateTime        @default(now())
  athlete              Athlete         @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  session              TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  poolDive             PoolDive        @relation(fields: [poolDiveId], references: [id], onDelete: Cascade)

  @@unique([athleteId, sessionId, poolDiveId])
}

model AthleteDiveNote {
  athleteId  String
  poolDiveId String
  note       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  athlete    Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  poolDive   PoolDive @relation(fields: [poolDiveId], references: [id], onDelete: Cascade)

  @@id([athleteId, poolDiveId])
  @@index([poolDiveId])
}

model AthleteExerciseLog {
  id         String          @id @default(cuid())
  athleteId  String
  sessionId  String
  exerciseId String
  completed  Boolean         @default(false)
  rating     String?
  note       String?
  athlete    Athlete         @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  session    TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise   DrylandExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([athleteId, sessionId, exerciseId])
}
