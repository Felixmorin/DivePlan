generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  COACH
  ATHLETE
}

enum WeekStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SessionStatus {
  DRAFT
  READY
  COMPLETED
}

enum BlockType {
  WARMUP
  DRYLAND
  POOL
  COOLDOWN
  CUSTOM
}

enum PoolHeight {
  ONE_METER
  THREE_METER
  PLATFORM
  CUSTOM
}

enum SkillStatus {
  NOT_STARTED
  LEARNING
  DEVELOPING
  MASTERED
}

enum CompletionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum InvitationEmailDeliveryStatus {
  NOT_ATTEMPTED
  SKIPPED_LOCAL
  SENT
  FAILED
}

model Club {
  id        String   @id @default(cuid())
  name      String
  logo      String?
  createdAt DateTime @default(now())
  users     User[]
  athletes  Athlete[]
  coaches   Coach[]
  groups    TrainingGroup[]
  weeks     TrainingWeek[]
  invitations UserInvitation[]
  events    AppEvent[]
  templates SessionTemplate[]
}

model User {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  role      UserRole
  passwordHash String?
  passwordSetAt DateTime?
  avatar    String?
  clubId    String?
  createdAt DateTime @default(now())
  club      Club?    @relation(fields: [clubId], references: [id])
  athlete   Athlete?
  coach     Coach?
  sentInvitations UserInvitation[] @relation("InvitedBy")
  acceptedInvitations UserInvitation[] @relation("AcceptedBy")
  events    AppEvent[]
}

model UserInvitation {
  id           String   @id @default(cuid())
  email        String
  firstName    String
  lastName     String
  role         UserRole
  tokenHash    String   @unique
  clubId       String
  groupId      String?
  invitedById  String
  acceptedById String?
  expiresAt    DateTime
  acceptedAt   DateTime?
  emailDeliveryStatus InvitationEmailDeliveryStatus @default(NOT_ATTEMPTED)
  emailDeliveryError  String?
  emailProviderMessageId String?
  emailSentAt   DateTime?
  createdAt    DateTime @default(now())
  club         Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  group        TrainingGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  invitedBy    User     @relation("InvitedBy", fields: [invitedById], references: [id])
  acceptedBy   User?    @relation("AcceptedBy", fields: [acceptedById], references: [id])

  @@index([clubId, email])
}

model AppEvent {
  id        String   @id @default(cuid())
  clubId    String?
  userId    String?
  type      String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())
  club      Club?    @relation(fields: [clubId], references: [id], onDelete: SetNull)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clubId, createdAt])
  @@index([type, createdAt])
}

model Athlete {
  id          String   @id @default(cuid())
  userId      String   @unique
  clubId      String
  groupId     String?
  birthDate   DateTime
  level       String
  active      Boolean  @default(true)
  user        User     @relation(fields: [userId], references: [id])
  club        Club     @relation(fields: [clubId], references: [id])
  group       TrainingGroup? @relation(fields: [groupId], references: [id])
  assignments SessionBlockAssignment[]
  completions AthleteSessionCompletion[]
  diveLogs    AthleteDiveLog[]
  exerciseLogs AthleteExerciseLog[]
  skills      AthleteSkill[]
}

model Coach {
  id        String @id @default(cuid())
  userId    String @unique
  clubId    String
  user      User   @relation(fields: [userId], references: [id])
  club      Club   @relation(fields: [clubId], references: [id])
  groups    TrainingGroup[]
  sessions  TrainingSession[]
}

model TrainingGroup {
  id        String @id @default(cuid())
  name      String
  clubId    String
  coachId   String
  club      Club   @relation(fields: [clubId], references: [id])
  coach     Coach  @relation(fields: [coachId], references: [id])
  athletes  Athlete[]
  weeks     TrainingWeek[]
  invitations UserInvitation[]
}

model TrainingWeek {
  id        String     @id @default(cuid())
  clubId    String
  groupId   String
  startDate DateTime
  title     String
  status    WeekStatus @default(DRAFT)
  club      Club       @relation(fields: [clubId], references: [id])
  group     TrainingGroup @relation(fields: [groupId], references: [id])
  sessions  TrainingSession[]
}

model TrainingSession {
  id        String   @id @default(cuid())
  date      DateTime
  title     String
  duration  Int
  focus     String
  notes     String?
  weekId    String
  coachId   String
  status    SessionStatus @default(DRAFT)
  week      TrainingWeek @relation(fields: [weekId], references: [id])
  coach     Coach @relation(fields: [coachId], references: [id])
  blocks    SessionBlock[]
  completions AthleteSessionCompletion[]
  diveLogs  AthleteDiveLog[]
  exerciseLogs AthleteExerciseLog[]
  templates SessionTemplate[]
}

model SessionBlock {
  id              String    @id @default(cuid())
  sessionId       String
  type            BlockType
  title           String
  description     String?
  duration        Int
  position        Int
  estimatedVolume Int       @default(0)
  session         TrainingSession @relation(fields: [sessionId], references: [id])
  assignments     SessionBlockAssignment[]
  drylandExercises DrylandBlockExercise[]
  poolTraining    PoolTraining?
}

model SessionBlockAssignment {
  id             String @id @default(cuid())
  sessionBlockId String
  athleteId      String
  sessionBlock   SessionBlock @relation(fields: [sessionBlockId], references: [id], onDelete: Cascade)
  athlete        Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([sessionBlockId, athleteId])
}

model DrylandExercise {
  id              String @id @default(cuid())
  name            String
  category        String
  description     String
  videoUrl        String?
  defaultSets     Int?
  defaultReps     Int?
  defaultDuration Int?
  equipment       String?
  tags            String[]
  blockExercises  DrylandBlockExercise[]
  logs            AthleteExerciseLog[]
}

model DrylandBlockExercise {
  blockId    String
  exerciseId String
  sets       Int?
  reps       Int?
  duration   Int?
  notes      String?
  order      Int
  block      SessionBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  exercise   DrylandExercise @relation(fields: [exerciseId], references: [id])

  @@id([blockId, exerciseId])
}

model PoolTraining {
  blockId  String @id
  block    SessionBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  sections PoolSection[]
}

model PoolSection {
  id             String @id @default(cuid())
  poolTrainingId String
  height         PoolHeight
  label          String?
  poolTraining   PoolTraining @relation(fields: [poolTrainingId], references: [blockId], onDelete: Cascade)
  dives          PoolDive[]
}

model PoolDive {
  id            String @id @default(cuid())
  poolSectionId String
  diveCode      String
  diveName      String
  position      String
  repetitions   Int
  notes         String?
  order         Int
  poolSection   PoolSection @relation(fields: [poolSectionId], references: [id], onDelete: Cascade)
  logs          AthleteDiveLog[]
}

model SessionTemplate {
  id        String @id @default(cuid())
  name      String
  category  String
  sessionId String?
  clubId    String
  favorite  Boolean @default(false)
  payload   Json
  session   TrainingSession? @relation(fields: [sessionId], references: [id])
  club      Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId, favorite, name])
  @@index([sessionId])
}

model Skill {
  id            String @id @default(cuid())
  name          String
  code          String @unique
  category      String
  height        String
  prerequisites String[]
  athleteSkills AthleteSkill[]
}

model AthleteSkill {
  athleteId String
  skillId   String
  level     Int
  progress  Int
  status    SkillStatus
  trainings Int @default(0)
  repetitions Int @default(0)
  athlete   Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  skill     Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([athleteId, skillId])
}

model AthleteSessionCompletion {
  athleteId   String
  sessionId   String
  startedAt   DateTime?
  completedAt DateTime?
  status      CompletionStatus @default(NOT_STARTED)
  rating      String?
  note        String?
  athlete     Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  session     TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([athleteId, sessionId])
}

model AthleteDiveLog {
  id                   String @id @default(cuid())
  athleteId            String
  sessionId            String
  poolDiveId           String
  repetitionsCompleted Int
  rating               String
  note                 String?
  timestamp            DateTime @default(now())
  athlete              Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  session              TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  poolDive             PoolDive @relation(fields: [poolDiveId], references: [id], onDelete: Cascade)

  @@unique([athleteId, sessionId, poolDiveId])
}

model AthleteExerciseLog {
  id         String @id @default(cuid())
  athleteId  String
  sessionId  String
  exerciseId String
  completed  Boolean @default(false)
  rating     String?
  note       String?
  athlete    Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  session    TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise   DrylandExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([athleteId, sessionId, exerciseId])
}
